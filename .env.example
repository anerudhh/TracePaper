# Set these in your deployment provider. Never commit a real .env file.
# The server reads process variables; it does not automatically load this file.
TRACEPAPER_DATA=./data
# Required for an Internet-facing private library. Use a long random value.
TRACEPAPER_PASSWORD=
# Visitors enter their own key inside Response settings; no server API key is used.
# Optional model overrides (non-secret).
TRACEPAPER_GEMINI_MODEL=gemini-3.8-flash
TRACEPAPER_OPENAI_MODEL=gpt-4.1-mini
# Optional English OCR: requires Tesseract language data on the server.
TRACEPAPER_OCR=0
